# 复制为 .env 并填入真实值；.env 已被 Git 忽略，不要提交真实密钥

# 火山方舟（豆包）
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_CHAT_MODEL=doubao-seed-2-1-pro-260628
ARK_EMBEDDING_MODEL=doubao-embedding-text-240715
EMBEDDING_DIM=2560

# Zilliz 云（北京区）
MILVUS_URI=
MILVUS_TOKEN=
MILVUS_COLLECTION=rag_agent_playground

# 分块与检索参数
CHUNK_SIZE=512
CHUNK_OVERLAP=50
RETRIEVAL_TOP_K=4

# 日志级别
LOG_LEVEL=INFO
